# Copy to .env and fill in. .env is git-ignored (SRS-NFR-04).

# Postgres connection (matches docker-compose.yml service "db").
# Host port 5433 avoids clashing with a native Postgres install on 5432.
DATABASE_URL=postgresql+psycopg://aaai:aaai_dev_pw@localhost:5433/aaai

APP_NAME=AAAI Backend
ENVIRONMENT=development

# Session token signing (SRS-NFR-04) — set to a long random string in real use.
SECRET_KEY=dev-insecure-change-me

# OpenAI (not called yet — reserved for SRS-FR-07/08/10/16)
OPENAI_API_KEY=
OPENAI_MONTHLY_BUDGET_USD=10.00

# Email delivery for magic links (SRS-FR-04). Dev default = links are logged, not sent.
# To send real emails, set EMAIL_ENABLED=true and fill in the SMTP settings below.
# Example for Gmail: host smtp.gmail.com, port 587, user = your address,
# password = a Google "App Password" (not your login password).
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=AAAI <no-reply@aaai.local>
SMTP_USE_TLS=true
SMTP_USE_SSL=false
