# Copy to .env and fill in. .env is git-ignored (SRS-NFR-04).

# Postgres connection (matches docker-compose.yml service "db").
# Host port 5433 avoids clashing with a native Postgres install on 5432.
DATABASE_URL=postgresql+psycopg://aaai:aaai_dev_pw@localhost:5433/aaai

APP_NAME=AAAI Backend
ENVIRONMENT=development

# Session token signing (SRS-NFR-04) — set to a long random string in real use.
# SECURITY: signs every login session - CHANGE THIS in your .env. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-insecure-change-me

# OpenAI (not called yet — reserved for SRS-FR-07/08/10/16)
OPENAI_API_KEY=
OPENAI_MONTHLY_BUDGET_USD=10.00
# AI pipeline. auto = OpenAI if OPENAI_API_KEY is set, else Groq if GROQ_API_KEY is
# set, else a labelled simulated provider. Tests always use the simulator.
AI_PROVIDER=auto
# Seconds each interview question gets (the candidate sees a per-question countdown).
QUESTION_SECONDS=120
OPENAI_TRANSCRIBE_MODEL=whisper-1
OPENAI_CHAT_MODEL=gpt-4o-mini
# Groq free tier (OpenAI-compatible) - key from console.groq.com, starts with gsk_
GROQ_API_KEY=
GROQ_TRANSCRIBE_MODEL=whisper-large-v3-turbo
GROQ_CHAT_MODEL=llama-3.3-70b-versatile

# Email delivery for magic links (SRS-FR-04). Dev default = links are logged, not sent.
# To send real emails, set EMAIL_ENABLED=true and fill in the SMTP settings below.
# Example for Gmail: host smtp.gmail.com, port 587, user = your address,
# password = a Google "App Password" (not your login password).
EMAIL_ENABLED=false
# Optional: your real inbox for demo logins. `python -m app.seed` makes it a
# recruiter and "<you>+candidate@..." a candidate (Gmail delivers +aliases to you).
SEED_REAL_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=AAAI <no-reply@aaai.local>
SMTP_USE_TLS=true
SMTP_USE_SSL=false
# Optional: send through Brevo's HTTPS API instead (hosts that block SMTP, e.g.
# Render free plan). SMTP_FROM must be a verified Brevo sender.
BREVO_API_KEY=

# SECURITY: keep false. True makes the API return sign-in tokens (tests only) -
# anyone could then sign in as any registered email.
EXPOSE_DEV_TOKENS=false
